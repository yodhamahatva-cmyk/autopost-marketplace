# Salin menjadi .env.local (pengembangan) atau isi sebagai Environment Variables di Vercel.

# --- Penyimpanan -----------------------------------------------------------
# supabase = produksi · berkas = simpan di folder ./data (pengembangan/lokal)
SUMBER_DATA=supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: RAHASIA. Hanya dipakai di server, jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key

# --- Keamanan dasbor -------------------------------------------------------
# Sandi untuk masuk ke dasbor. Bila kosong, dasbor terbuka tanpa sandi (khusus lokal).
SANDI_DASBOR=ganti-dengan-sandi-yang-kuat
# Opsional: kunci tanda tangan cookie sesi (acak, bebas). Bila kosong, memakai SANDI_DASBOR.
SESI_RAHASIA=

# --- Opsional --------------------------------------------------------------
NAMA_APLIKASI=AutoPost Iklan
# Hanya untuk SUMBER_DATA=berkas
DATA_DIR=./data
